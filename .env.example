# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Free key from https://console.groq.com (no card needed)
GROQ_API_KEY=

# Optional overrides (any setting in src/meddoc_rag/config.py, prefixed MEDDOC_)
# MEDDOC_LLM_PROVIDER=groq            # or: ollama (local, offline)
# MEDDOC_LLM_MODEL=openai/gpt-oss-120b   # check available models: GET https://api.groq.com/openai/v1/models
# MEDDOC_REFUSAL_THRESHOLD=0.5
# MEDDOC_RETRIEVER=hybrid+rerank
